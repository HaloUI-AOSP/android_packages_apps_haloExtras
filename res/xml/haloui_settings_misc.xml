<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/misc_title">

    <!-- Ignore window secure flags -->
    <com.haloui.settings.preferences.GlobalSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="false" />

    <!-- Play Integrity Fix -->
    <Preference
        android:key="play_integrity_fix"
        android:title="@string/play_integrity_fix_title"
        android:summary="@string/play_integrity_fix_summary"
        android:fragment="com.haloui.settings.fragments.misc.PlayIntegrityFix" />

    <!-- TrickyStore -->
    <Preference
        android:key="tricky_store"
        android:title="@string/tricky_store_title"
        android:summary="@string/tricky_store_summary"
        android:fragment="com.haloui.settings.fragments.misc.TrickyStore" />

    <!-- Game Spoofing -->
    <Preference
        android:key="game_spoofing"
        android:title="@string/game_spoofing_title"
        android:summary="@string/game_spoofing_summary"
        android:fragment="com.haloui.settings.fragments.misc.GameSpoofing" />
</PreferenceScreen>
